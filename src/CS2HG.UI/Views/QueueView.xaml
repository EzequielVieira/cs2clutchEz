<UserControl x:Class="CS2HG.UI.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CS2HG.UI">
    <Grid Margin="32,26,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource AccentButton}" Command="{Binding StartCommand}" Margin="0,0,8,0" AutomationProperties.Name="{l:Tr queue.start}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr queue.start}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding PauseCommand}" Content="{l:Tr queue.pause}" />
                <Button Style="{StaticResource GhostButton}" Command="{Binding CancelAllCommand}" Content="{l:Tr queue.cancelAll}" />
                <Button Style="{StaticResource GhostButton}" Command="{Binding ClearFinishedCommand}" Content="{l:Tr queue.clearFinished}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:Tr nav.queue}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,14">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{l:Tr queue.paused}" Foreground="{StaticResource WarningBrush}" FontWeight="Bold"
                               Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{l:Tr queue.total}" Style="{StaticResource SectionTitle}" />
                </DockPanel>
                <ProgressBar Value="{Binding TotalProgress, Mode=OneWay}" Maximum="100" Height="8" />
                <TextBlock Text="{l:Tr queue.hint}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="128" Height="72" CornerRadius="6" Background="#232833" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4A5262" />
                                        <Image Source="{Binding Thumbnail, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="4" Padding="6,1" Margin="0,0,8,0" Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="#111" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,3,0,6" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                                    <DockPanel Margin="0,5,0,0">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}">
                                            <Run Text="{Binding Segments, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding PovText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Stage}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="{l:Tr queue.watch}"
                                            Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="{l:Tr queue.openFolder}"
                                            Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="{l:Tr queue.retry}"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="{l:Tr queue.moveUp}"
                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="{l:Tr queue.moveDown}"
                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{l:Tr common.cancel}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{l:Tr queue.remove}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisInv}}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
