<UserControl x:Class="CS2HG.UI.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CS2HG.UI">
    <Grid Margin="32,26,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:Tr analysis.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Details}" Style="{StaticResource PageSubtitle}" Margin="0,0,0,16" />
        </StackPanel>

        <!-- Progress -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding ProgressText}" Margin="0,0,0,8" />
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8" />
            </StackPanel>
        </Border>

        <!-- Summary tiles -->
        <UniformGrid Grid.Row="2" Rows="1" Margin="0,0,0,14" Visibility="{Binding HasDemo, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="{l:Tr analysis.map}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding MapName}" Style="{StaticResource BigNumber}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="{l:Tr analysis.score}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Score}" Style="{StaticResource BigNumber}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="{l:Tr analysis.rounds}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding RoundCount}" Style="{StaticResource BigNumber}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="{l:Tr analysis.kills}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding KillCount}" Style="{StaticResource BigNumber}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="{l:Tr analysis.duration}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Duration}" Style="{StaticResource BigNumber}" /></StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3" Visibility="{Binding HasDemo, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="9*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding MatchTitle}" Style="{StaticResource SectionTitle}" />
                    <Border DockPanel.Dock="Bottom" Background="#1F242D" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding AnalyzeCommand}" AutomationProperties.Name="{l:Tr analysis.find}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:Tr analysis.find}" />
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock>
                                    <Run Text="{l:Tr analysis.playerLabel}" Foreground="{StaticResource MutedBrush}" />
                                    <Run Text="{Binding SelectedPlayer.Name, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <CheckBox Content="{l:Tr analysis.allPlayersCheck}" IsChecked="{Binding AnalyzeAllPlayers}" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Tr common.player}" Binding="{Binding Name}" Width="*" MinWidth="170" ElementStyle="{StaticResource CenterText}" />
                            <DataGridTextColumn Header="{l:Tr analysis.team}" Binding="{Binding Team}" Width="72" />
                            <DataGridTextColumn Header="K" Binding="{Binding Kills}" Width="45" />
                            <DataGridTextColumn Header="D" Binding="{Binding Deaths}" Width="45" />
                            <DataGridTextColumn Header="A" Binding="{Binding Assists}" Width="45" />
                            <DataGridTextColumn Header="HS%" Binding="{Binding Hs}" Width="60" />
                            <DataGridTextColumn Header="ADR" Binding="{Binding Adr}" Width="55" />
                            <DataGridTextColumn Header="{l:Tr analysis.multi}" Binding="{Binding Multi}" Width="80" />
                            <DataGridTextColumn Header="{l:Tr analysis.clutch}" Binding="{Binding Clutches}" Width="65" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Tr analysis.rounds}" Style="{StaticResource SectionTitle}" />
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='⚠ {0}'}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontSize="12" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DataGrid ItemsSource="{Binding Rounds}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                            <DataGridTextColumn Header="{l:Tr analysis.winner}" Binding="{Binding Winner}" Width="78" />
                            <DataGridTextColumn Header="{l:Tr analysis.how}" Binding="{Binding Reason}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="CT:T" Binding="{Binding Score}" Width="55" />
                            <DataGridTextColumn Header="{l:Tr analysis.bomb}" Binding="{Binding Bomb}" Width="100" />
                            <DataGridTextColumn Header="{l:Tr analysis.kills}" Binding="{Binding Kills}" Width="45" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{l:Tr analysis.empty}" Style="{StaticResource PageSubtitle}"
                   Visibility="{Binding HasDemo, Converter={StaticResource BoolToVisInv}}" />
    </Grid>
</UserControl>
