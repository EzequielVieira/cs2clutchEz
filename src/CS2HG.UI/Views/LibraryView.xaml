<UserControl x:Class="CS2HG.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CS2HG.UI">
    <Grid Margin="32,26,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource GhostButton}" Content="{l:Tr clips.openRoot}" Command="{Binding OpenRootCommand}" />
                <Button Style="{StaticResource AccentButton}" Command="{Binding MontageCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                        ToolTip="{l:Tr clips.montageTip}" AutomationProperties.Name="{l:Tr clips.montage}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr clips.montage}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:Tr nav.clips}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0" Width="300" HorizontalAlignment="Left" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Clips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Margin="0,0,14,14" CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Height="168">
                                    <Border CornerRadius="10,10,0,0" Background="#232833" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                                    </Border>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="{l:Tr clips.markTip}" />
                                    <Button Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" Opacity="0.9"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="27" Background="#CC000000">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <StackPanel Margin="12,10">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                                                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr clips.folder}" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr clips.copy}" ToolTip="{l:Tr clips.copyTip}"
                                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
