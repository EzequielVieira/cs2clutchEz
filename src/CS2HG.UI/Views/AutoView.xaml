<UserControl x:Class="CS2HG.UI.Views.AutoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CS2HG.UI">
    <Grid Margin="32,26,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{l:Tr auto.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:Tr auto.subtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="{l:Tr auto.addRecent}" Command="{Binding AddRecentCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}" />
                            <Button Style="{StaticResource GhostButton}" Content="{l:Tr auto.addDemos}" Command="{Binding AddDemosCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}" Margin="8,0,0,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding ClearCommand}" ToolTip="{l:Tr auto.clear}" Margin="8,0,0,0" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}" />
                        </StackPanel>
                        <TextBlock Text="{l:Tr auto.matches}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <TextBlock Text="{l:Tr auto.emptyList}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Items.Count, Converter={StaticResource BoolToVisInv}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8" Background="#151920" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{l:Tr queue.remove}"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr auto.options}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Tr auto.top}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding TopValues}" SelectedItem="{Binding Top}" />
                        <TextBlock Text="{l:Tr auto.player}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="{l:Tr auto.export}" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                        <TextBlock Text="{Binding ExportSummary}" TextWrapping="Wrap" />
                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr auto.changeExport}" Command="{Binding OpenExportCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding StartCommand}" HorizontalAlignment="Stretch"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisInv}}" AutomationProperties.Name="{l:Tr auto.start}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Tr auto.start}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr common.cancel}" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,12,0,0"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr home.openQueue}" Command="{Binding OpenQueueCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
