<UserControl x:Class="CS2HG.UI.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CS2HG.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,24" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="{l:Tr export.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding SelectionText}" Style="{StaticResource PageSubtitle}" Margin="0,0,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr export.video}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Tr export.resolution}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" />
                        <TextBlock Text="FPS" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding FpsValues}" SelectedItem="{Binding Fps}" />
                        <TextBlock Text="{l:Tr export.codec}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding Codec}" />
                        <TextBlock Text="Bitrate (kbps)" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Bitrate}" />
                        <TextBlock Text="{l:Tr export.folder}" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:Tr common.browse}" Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding OutputFolder}" />
                        </DockPanel>
                        <TextBlock Text="{l:Tr export.folderHint}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr export.play}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Tr export.before}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding BeforeValues}" SelectedItem="{Binding SecondsBefore}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Tr export.after}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding AfterValues}" SelectedItem="{Binding SecondsAfter}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:Tr export.pov}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding PovModes}" SelectedItem="{Binding Pov}" />
                        <TextBlock Text="{l:Tr export.povPlayer}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Players}" SelectedItem="{Binding SpecificPlayer}" DisplayMemberPath="Name" />
                        <TextBlock Text="HUD" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding HudModes}" SelectedItem="{Binding Hud}" />
                        <CheckBox Content="{l:Tr export.audio}" IsChecked="{Binding RecordAudio}" Margin="0,12,0,0" />
                        <CheckBox Content="{l:Tr export.overlay}" IsChecked="{Binding AddTitleOverlay}" Margin="0,6,0,0" />
                        <CheckBox Content="{l:Tr export.transitions}" IsChecked="{Binding FadeTransitions}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#21231C" BorderBrush="#4A4320" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <TextBlock Text="{Binding CaptureNote}" TextWrapping="Wrap" Foreground="#E9D9A6" />
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource AccentButton}" Command="{Binding RenderCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" AutomationProperties.Name="{l:Tr export.render}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr export.render}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Content="{l:Tr export.saveDefault}" Command="{Binding SaveAsDefaultCommand}" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
