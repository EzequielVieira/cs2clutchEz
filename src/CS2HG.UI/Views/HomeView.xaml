<UserControl x:Class="CS2HG.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CS2HG.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,24">
            <TextBlock Text="{l:Tr home.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:Tr home.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,0,0,20" />

            <!-- Drop zone -->
            <Border AllowDrop="True" Drop="OnDrop" CornerRadius="14" Padding="28" Margin="0,0,0,18" BorderThickness="2" Cursor="Hand">
                <Border.BorderBrush>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Rectangle StrokeDashArray="6 4" Stroke="#3A4250" StrokeThickness="2" Width="400" Height="100" RadiusX="14" RadiusY="14" />
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#1E1A16" />
                        <GradientStop Offset="1" Color="#16191F" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="22,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr home.dropTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{l:Tr home.dropText}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding ImportCommand}" VerticalAlignment="Center"
                            AutomationProperties.Name="{l:Tr home.import}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Tr home.import}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Share code -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{l:Tr home.shareCodeTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="{l:Tr home.shareCodeHint}" Style="{StaticResource Muted}" MaxWidth="380" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding ShareCodeText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                             FontFamily="Consolas" FontSize="15" AutomationProperties.Name="{l:Tr home.shareCodeTitle}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr home.paste}" Command="{Binding PasteShareCodeCommand}" />
                        <Button Style="{StaticResource AccentButton}" Command="{Binding OpenShareCodeCommand}" AutomationProperties.Name="{l:Tr home.downloadAnalyze}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Tr home.downloadAnalyze}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Recent demos -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr home.recent}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{l:Tr home.recentEmpty}" Style="{StaticResource Muted}"
                                       Visibility="{Binding RecentDemos.Count, Converter={StaticResource BoolToVisInv}}" />
                            <ItemsControl ItemsSource="{Binding RecentDemos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="12,8" Cursor="Hand">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{l:Tr common.open}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Matches downloaded by CS2 -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding LocalMatches.Count, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr home.localMatches}" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding LocalMatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr home.copyCode}"
                                                        Command="{Binding DataContext.CopyShareCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr common.open}" Margin="0"
                                                        Command="{Binding DataContext.OpenLocalMatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Muted}">
                                                    <Run Text="{Binding ShareCode, Mode=OneWay}" FontFamily="Consolas" /><Run Text="  •  " /><Run Text="{Binding Details, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- History -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr home.history}" Style="{StaticResource SectionTitle}" />
                            <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="None" MaxHeight="260" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:Tr common.map}" Binding="{Binding Map}" Width="110" />
                                    <DataGridTextColumn Header="{l:Tr common.player}" Binding="{Binding Player}" Width="*" />
                                    <DataGridTextColumn Header="{l:Tr nav.highlights}" Binding="{Binding Count}" Width="90" />
                                    <DataGridTextColumn Header="{l:Tr common.status}" Binding="{Binding Status}" Width="100" />
                                    <DataGridTextColumn Header="{l:Tr home.when}" Binding="{Binding When}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- App status -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="{l:Tr home.recheck}"
                                        Command="{Binding CheckEnvironmentCommand}" />
                                <TextBlock Text="{l:Tr home.appStatus}" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <ProgressBar IsIndeterminate="True" Visibility="{Binding CheckingEnvironment, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Environment}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10">
                                            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top"
                                                     Fill="{Binding Ok, Converter={StaticResource StatusBrush}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Queue -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr nav.queue}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Content="{l:Tr home.openQueue}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Queue" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr home.howTitle}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="{l:Tr home.how1}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{l:Tr home.how2}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{l:Tr home.how3}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
