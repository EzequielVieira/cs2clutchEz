<Application x:Class="CS2HG.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CS2HG.UI"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Assets/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
            <ui:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
            <ui:InverseBoolConverter x:Key="Not" />
            <ui:PathToImageConverter x:Key="PathToImage" />
            <ui:StatusToBrushConverter x:Key="StatusBrush" />
            <ui:CategoryToBrushConverter x:Key="CategoryBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
