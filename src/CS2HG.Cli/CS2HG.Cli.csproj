<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>cs2clutchez-cli</AssemblyName>
    <RootNamespace>CS2HG.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CS2HG.Application\CS2HG.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\ffmpeg\*.*" Link="tools\ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tools\ffmpeg\ffmpeg.exe')" />
  </ItemGroup>

</Project>
